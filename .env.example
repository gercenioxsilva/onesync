# ── Docker registry mirror (opcional) ────────────────────────────────────────
# Útil em ambientes com restrição de acesso ao Docker Hub
REGISTRY_PREFIX=mirror.gcr.io/library/

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/people_db
ENVIRONMENT=local
ENABLE_SCHEMA_AUTOCREATE=true

# CORS: JSON array com as origens permitidas
# Produção: CORS_ORIGINS=["https://app.seudominio.com"]
CORS_ORIGINS=["http://localhost:5173"]

# JWT — troque em produção por um valor seguro (ex: openssl rand -hex 32)
AUTH_SECRET_KEY=local-dev-secret-key-change-me

# Bootstrap: cria tenant e usuário admin automaticamente na primeira subida
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_OWNER_EMAIL=admin@people.local
AUTH_BOOTSTRAP_OWNER_PASSWORD=admin123
AUTH_BOOTSTRAP_PLAN=FREE

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
