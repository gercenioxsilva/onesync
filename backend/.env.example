# Database Configuration
# PostgreSQL (Recommended for production/AWS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/people_db

# SQLite (For local development without Docker)
# DATABASE_URL=sqlite:///./people.db

# Application Settings
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173"]
TRACKER_CSV_PATH=../01_TRACKER_TIME.csv

# Authentication Settings
AUTH_SECRET_KEY=local-dev-secret-key-change-me
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
